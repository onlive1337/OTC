# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required - comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789

# Optional - Telegram chat ID for logging
LOG_CHAT_ID=

# CoinGecko free Demo API key for crypto rates (not a Pro key)
COINGECKO_DEMO_API_KEY=

# Optional - CoinCap API key for fallback crypto rates
COINCAP_API_KEY=

# Optional - logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional - path to SQLite database
DB_PATH=otc.db

# Optional - maximum concurrently processed Telegram updates (default 100)
POLLING_CONCURRENCY=100

# Optional - seconds to wait for active update handlers on shutdown (default 8, 0 disables)
POLLING_SHUTDOWN_TIMEOUT=8

# Optional - Bot API 10.5 settings sync on startup
SYNC_BOT_SETTINGS=true
ENABLE_WIDGET_CALC=false
INLINE_QUERY_PLACEHOLDER=100 USD, 50+50, 100 USD EUR
CALLBACK_QUERY_MODE=default
